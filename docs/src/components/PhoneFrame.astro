---
/**
 * Android device frame for screenshots. Put an image (or nothing) inside:
 *
 *   <PhoneFrame caption="The theme editor">
 *     ![Theme editor](../../assets/screens/theme-editor.webp)
 *   </PhoneFrame>
 *
 * With no child, renders a “screenshot pending” placeholder so stub pages
 * still look intentional. `wide` lays two frames side by side when wrapped
 * in a normal markdown paragraph flow.
 *
 * `side` sets the frame aside: a smaller phone floated to the right of the
 * prose that follows it, for a screenshot that illustrates a paragraph
 * rather than being the thing the section is about. Below the float
 * breakpoint it falls back to a centred, still-smaller frame.
 */
interface Props {
	caption?: string;
	side?: boolean;
}
const { caption, side = false } = Astro.props;
---

<figure class:list={['phone', { 'phone-side': side }]}>
	<div class="phone-body">
		<div class="phone-speaker" aria-hidden="true"></div>
		<div class="phone-screen">
			<slot>
				<div class="placeholder">
					<svg
						aria-hidden="true"
						width="42"
						height="42"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
						<circle cx="9" cy="9" r="2"></circle>
						<path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
					</svg>
					<span>Screenshot pending</span>
				</div>
			</slot>
		</div>
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.phone {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		margin: 1.5rem auto;
		max-width: 20rem;
		container-type: inline-size;
	}
	/* Bezel geometry is written twice: rem values first as a fallback, then
	   cqw values that scale with the frame's rendered width. 1cqw = 0.2rem at
	   the default 20rem, so the cqw numbers reproduce the rem look exactly
	   there and shrink proportionally when a page renders the frame smaller
	   (the homepage feature rows cap it at 10rem). */
	.phone-body {
		width: 100%;
		padding: 0.9rem 0.55rem 0.7rem;
		padding: 4.5cqw 2.75cqw 3.5cqw;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1.8rem;
		border-radius: 9cqw;
		background: linear-gradient(180deg, var(--sl-color-gray-6), var(--sl-color-black));
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
		box-shadow: 0 3.75cqw 12.5cqw rgba(0, 0, 0, 0.25);
	}
	.phone-speaker {
		width: 5rem;
		width: 25cqw;
		height: 0.32rem;
		height: 1.6cqw;
		margin: 0 auto 0.6rem;
		margin: 0 auto 3cqw;
		border-radius: 999px;
		background: var(--sl-color-gray-5);
	}
	.phone-screen {
		overflow: hidden;
		border-radius: 1.1rem;
		border-radius: 5.5cqw;
		background: var(--sl-color-gray-6);
	}
	.phone-screen :global(img),
	.phone-screen :global(video) {
		display: block;
		width: 100%;
		/* Keep the intrinsic aspect ratio even inside `not-content` wrappers,
		   where Starlight's own `img { height: auto }` doesn't reach and the
		   width/height attributes would otherwise distort the image. */
		height: auto;
		border-radius: 0 !important;
		margin: 0 !important;
	}
	.placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		aspect-ratio: 9 / 17;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		background:
			radial-gradient(14rem 10rem at 50% 0%, rgba(76, 141, 246, 0.14), transparent 70%),
			repeating-linear-gradient(
				45deg,
				transparent,
				transparent 12px,
				rgba(128, 128, 160, 0.05) 12px,
				rgba(128, 128, 160, 0.05) 24px
			);
	}
	figcaption {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		text-align: center;
	}

	/* Set aside: centred and smaller on a phone, floated beside the prose
	   once the column is wide enough to keep ~30rem of text next to it. */
	.phone-side {
		max-width: 16.8rem;
	}
	@media (min-width: 50rem) {
		.phone-side {
			float: right;
			clear: right;
			width: 14.4rem;
			margin: 2.5rem 0 1rem 1.75rem;
		}
		.phone-side figcaption {
			padding-inline: 0.25rem;
			font-size: var(--sl-text-xs);
			line-height: 1.4;
		}
	}
</style>
