---
/**
 * Breadcrumb chip showing where a setting lives in the app.
 * Usage: <SettingsPath path="Typing / Autocorrect / Confidence" />
 * Always renders the app name as the first crumb.
 *
 * On an Android phone the chip is also a link: the path is resolved against
 * the app's settings index (src/lib/settings-links.mjs) into a `wmkeyboard://`
 * address, and a small script sets it as the href once it knows the page is
 * being read on Android. Anywhere else the chip stays plain text, since only
 * a phone with WM Keyboard installed can open the address.
 */
import { resolveSettingsLink } from '../lib/settings-links.mjs';

interface Props {
	path: string;
}
const { path } = Astro.props;
const crumbs = ['WM Keyboard', ...path.split('/').map((c) => c.trim())];
const link = resolveSettingsLink(path);
---

<a
	class="settings-path"
	title={`Settings location: ${crumbs.join(' → ')}`}
	data-href={link?.href}
	data-exact={link ? String(link.exact) : undefined}
>
	<svg
		aria-hidden="true"
		width="14"
		height="14"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<circle cx="12" cy="12" r="3"></circle>
		<path
			d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
		></path>
	</svg>
	{
		crumbs.map((crumb, i) => (
			<>
				{i > 0 && <span class="sep" aria-hidden="true">›</span>}
				<span class="crumb">{crumb}</span>
			</>
		))
	}
	<svg
		class="open"
		aria-hidden="true"
		width="13"
		height="13"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2.2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path d="M7 17 17 7"></path>
		<path d="M9 7h8v8"></path>
	</svg>
</a>

<script>
	// Only Android can open a wmkeyboard:// address. Chromium browsers there
	// can also say whether the app is installed (the site's web manifest names
	// the package, the app's asset statement names the site), and then the
	// chip is a link only when it is. A browser without that API, Firefox for
	// one, has no way to know, so the chip links anyway rather than never.
	const PACKAGE = 'com.wasimaster.wmkeyboard';
	type RelatedApp = { id?: string; platform?: string };
	type Nav = Navigator & {
		userAgentData?: { platform?: string };
		getInstalledRelatedApps?: () => Promise<RelatedApp[]>;
	};
	const nav = navigator as Nav;
	const onAndroid = /\bAndroid\b/i.test(nav.userAgent) || nav.userAgentData?.platform === 'Android';

	/** true or false when the browser can tell, null when it cannot. */
	async function appInstalled(): Promise<boolean | null> {
		if (typeof nav.getInstalledRelatedApps !== 'function') return null;
		try {
			const apps = await nav.getInstalledRelatedApps();
			return apps.some((app) => app.id === PACKAGE);
		} catch {
			// Not a top-level secure context, or the manifest did not load.
			return null;
		}
	}

	function linkChips() {
		for (const chip of document.querySelectorAll<HTMLAnchorElement>('a.settings-path[data-href]')) {
			const href = chip.dataset.href;
			if (!href) continue;
			chip.href = href;
			chip.classList.add('is-link');
			chip.title =
				chip.dataset.exact === 'false'
					? 'Open the screen that holds this setting in WM Keyboard'
					: 'Open this setting in WM Keyboard';
		}
	}

	if (onAndroid) {
		appInstalled().then((installed) => {
			document.documentElement.dataset.wmApp =
				installed === null ? 'unknown' : installed ? 'installed' : 'absent';
			if (installed !== false) linkChips();
		});
	}
</script>


<style>
	.settings-path {
		display: inline-flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.35em;
		padding: 0.3em 0.75em;
		margin-block: 0.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.4;
		text-decoration: none;
	}
	.settings-path:hover {
		color: var(--sl-color-gray-2);
	}
	.settings-path svg {
		color: var(--sl-color-accent);
		flex-shrink: 0;
	}
	.sep {
		color: var(--sl-color-gray-4);
	}
	.crumb:last-of-type {
		color: var(--sl-color-white);
		font-weight: 600;
	}
	/* The open-in-app arrow only exists once the script has made a link. */
	.open {
		display: none;
	}
	.settings-path.is-link {
		border-color: var(--sl-color-accent);
		cursor: pointer;
	}
	.settings-path.is-link .open {
		display: inline;
		margin-inline-start: 0.1em;
	}
	.settings-path.is-link .crumb:last-of-type {
		text-decoration: underline;
		text-decoration-color: var(--sl-color-accent);
		text-underline-offset: 0.2em;
	}
	.settings-path.is-link:active {
		background: var(--sl-color-accent-low);
	}
</style>
