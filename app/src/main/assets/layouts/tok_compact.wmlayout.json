{
  "format": "wmkeyboard-layout",
  "version": 1,
  "layout": {
    "id": "asset_tok_compact",
    "name": "toki pona lili (Toki Pona compact)",
    "langId": "tok",
    "version": 2,
    "layers": {
      "letters": {
        "rows": [
          [
            {
              "label": "[",
              "shiftLabel": "?"
            },
            {
              "label": "w"
            },
            {
              "label": "e"
            },
            {
              "label": "t"
            },
            {
              "label": "u"
            },
            {
              "label": "i"
            },
            {
              "label": "o"
            },
            {
              "label": "p"
            },
            {
              "label": "]",
              "shiftLabel": "!"
            }
          ],
          [
            {
              "label": "⇧",
              "action": {
                "type": "shift"
              },
              "width": 1.5
            },
            {
              "label": "a"
            },
            {
              "label": "s"
            },
            {
              "label": "n"
            },
            {
              "label": "m"
            },
            {
              "label": "j",
              "longPress": [
                "y"
              ]
            },
            {
              "label": "k"
            },
            {
              "label": "l"
            },
            {
              "label": "⌫",
              "action": {
                "type": "delete"
              },
              "width": 1.5
            }
          ],
          [
            {
              "label": "?123",
              "action": {
                "type": "symbols"
              },
              "width": 1.5
            },
            {
              "label": ",",
              "longPress": [
                "!",
                "?"
              ],
              "role": "Comma"
            },
            {
              "label": "🌐",
              "action": {
                "type": "language_switch"
              }
            },
            {
              "label": " ",
              "action": {
                "type": "space"
              },
              "width": 4
            },
            {
              "label": ".",
              "longPress": [
                "…",
                ",",
                "?",
                "!",
                ":",
                ";"
              ],
              "role": "Period"
            },
            {
              "label": "⏎",
              "action": {
                "type": "enter"
              },
              "width": 1.5
            }
          ]
        ]
      }
    }
  }
}
