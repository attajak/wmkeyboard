                "?",
                "!",
                "'",
                "-",
                ":",
                ";"
              ],
              "role": "Period"
            },
            {
              "label": "ABC",
              "output": "a",
              "longPress": [
                "2",
                "a",
                "b",
                "c",
                "ä",
                "č",
                "ć"
              ],
              "letters": "abcäčć"
            },
            {
              "label": "DEF",
              "output": "d",
              "longPress": [
                "3",
                "d",
                "e",
                "f",
                "ě"
              ],
              "letters": "defě"
            },
            {
              "label": "⌫",
              "action": {
                "type": "delete"
              }
            }
          ],
          [
            {
              "label": "GHI",
              "output": "g",
              "longPress": [
                "4",
                "g",
                "h",
                "i"
              ],
              "letters": "ghi"
            },
            {
              "label": "JKL",
              "output": "j",
              "longPress": [
                "5",
                "j",
                "k",
                "l",
                "ł"
              ],
              "letters": "jklł"
            },
            {
              "label": "MNO",
              "output": "m",
              "longPress": [
                "6",
                "m",
                "n",
                "o",
                "ń",
                "ó",
                "ö"
              ],
              "letters": "mnońóö"
            },
            {
              "label": "⇧",
              "action": {
                "type": "shift"
              }
            }
          ],
          [
            {
              "label": "PQRS",
              "output": "p",
              "longPress": [
                "7",
                "p",
                "q",
                "r",
                "s",
                "ř",
                "ŕ",
                "š",
                "ś",
                "ß"
              ],
              "letters": "pqrsřŕšśß"
            },
            {
              "label": "TUV",
              "output": "t",
              "longPress": [
                "8",
                "t",
                "u",
                "v",
                "ü"
              ],
              "letters": "tuvü"
            },
            {
              "label": "WXYZ",
              "output": "w",
              "longPress": [
                "9",
                "w",
                "x",
                "y",
                "z",
                "ž",
                "ź"
