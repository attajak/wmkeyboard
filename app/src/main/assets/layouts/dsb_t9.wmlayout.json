              "label": "⏎",
              "action": {
                "type": "enter"
              }
            }
          ],
          [
            {
              "label": "?123",
              "action": {
                "type": "symbols"
              }
            },
            {
              "label": "🌐",
              "action": {
                "type": "language_switch"
              }
            },
            {
              "label": " ",
              "action": {
                "type": "space"
              },
              "width": 2
            }
          ]
        ]
