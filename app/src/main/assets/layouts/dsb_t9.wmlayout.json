{
  "format": "wmkeyboard-layout",
  "version": 1,
  "layout": {
    "id": "asset_dsb_t9",
    "name": "T9 (Dolnoserbski)",
    "langId": "dsb",
    "layers": {
      "letters": {
        "rows": [
          [
            {
              "label": ".,?",
              "output": ".",
