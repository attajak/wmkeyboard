{
  "format": "wmkeyboard-layout",
  "version": 1,
  "layout": {
    "id": "asset_zh_handwriting",
    "name": "中文 手写 (Chinese Handwriting)",
    "langId": "zh",
    "tabletExpand": false,
    "handwriting": true,
    "version": 2,
    "layers": {
      "letters": {
        "rows": [
          [
            { "label": "?123", "action": { "type": "symbols" }, "width": 1.5 },
            { "label": "，", "longPress": ["！", "？", "、"], "role": "Comma" },
            { "label": "🌐", "action": { "type": "language_switch" } },
            { "label": " ", "action": { "type": "space" }, "width": 3.5 },
            { "label": "。", "longPress": ["…", "，", "？", "！", "：", "；"], "role": "Period" },
            { "label": "⌫", "action": { "type": "delete" }, "width": 1.25 },
            { "label": "⏎", "action": { "type": "enter" }, "width": 1.25 }
          ]
        ]
      }
    }
  }
}
