<?xml version="1.0" encoding="utf-8"?>
<!-- The KDE Connect tool's settings (issue #285). -->
<resources>
    <string name="kdeconnect_share_label">Send to computer</string>

    <!-- State banner -->
    <string name="kdeconnect_banner_off">Off. Nothing is sent to or heard from your network</string>
    <string name="kdeconnect_banner_locked">Unlock the phone once after a restart to use this</string>
    <string name="kdeconnect_banner_no_devices">On. No computer is paired yet</string>
    <string name="kdeconnect_banner_connected">Connected to %1$s</string>
    <string name="kdeconnect_banner_idle">On. %1$d paired, none connected right now</string>
    <string name="kdeconnect_banner_action_pair">Pair a computer</string>
    <string name="kdeconnect_banner_action_devices">Devices</string>

    <!-- Main -->
    <string name="kdeconnect_group_main">KDE Connect</string>
    <string name="kdeconnect_group_main_info">Pairs this keyboard with a computer that runs KDE Connect, GSConnect or Valent, over your local network. The keyboard shows up there as its own device, so the KDE Connect app is not needed on the phone.</string>
    <string name="kdeconnect_enabled_title">Use KDE Connect</string>
    <string name="kdeconnect_enabled_subtitle">Look for paired computers and let them find this phone</string>
    <string name="kdeconnect_devices_title">Devices</string>
    <string name="kdeconnect_devices_subtitle_none">Pair a computer</string>
    <string name="kdeconnect_devices_subtitle">%1$d paired</string>
    <string name="kdeconnect_name_label">Name shown on the computer</string>
    <string name="kdeconnect_name_hint">Blank uses the phone\'s model. 32 characters, no punctuation</string>

    <!-- Connection -->
    <string name="kdeconnect_group_connection">Connection</string>
    <string name="kdeconnect_lifetime_title">Stay connected</string>
    <string name="kdeconnect_lifetime_info">There is no background service. The link lives inside the keyboard, so even Always ends when Android closes the keyboard, and battery saving may pause it.</string>
    <string name="kdeconnect_lifetime_panel">Panel open</string>
    <string name="kdeconnect_lifetime_keyboard">Keyboard showing</string>
    <string name="kdeconnect_lifetime_always">Always</string>
    <string name="kdeconnect_lifetime_panel_detail">Only while the KDE Connect panel is open. The computer cannot type or send the clipboard at other times.</string>
    <string name="kdeconnect_lifetime_keyboard_detail">While the keyboard is on screen, and for a minute after.</string>
    <string name="kdeconnect_lifetime_always_detail">Whenever this is the active keyboard, shown or not. Uses more battery.</string>
    <string name="kdeconnect_auto_connect_title">Connect automatically</string>
    <string name="kdeconnect_auto_connect_subtitle">Reconnect to paired computers when they are found</string>

    <!-- Clipboard -->
    <string name="kdeconnect_group_clipboard">Clipboard</string>
    <string name="kdeconnect_clipboard_receive_title">Receive the computer\'s clipboard</string>
    <string name="kdeconnect_clipboard_receive_subtitle">Text copied there is ready to paste here</string>
    <string name="kdeconnect_clipboard_send_title">Send this phone\'s clipboard</string>
    <string name="kdeconnect_clipboard_send_subtitle">Text copied here is ready to paste there</string>
    <string name="kdeconnect_clipboard_send_info">Passwords and codes are never sent by themselves. Nothing is sent from a password field, or while incognito pauses the clipboard. The Send tab can still send the clipboard when you ask.</string>

    <!-- Typing from the computer -->
    <string name="kdeconnect_group_typing">Typing from the computer</string>
    <string name="kdeconnect_remote_typing_title">Let the computer type here</string>
    <string name="kdeconnect_remote_typing_subtitle">Its keyboard types into the field, while this keyboard is showing and the phone is unlocked</string>
    <string name="kdeconnect_pipeline_title">Use the keyboard language</string>
    <string name="kdeconnect_pipeline_subtitle">Run its keys through this keyboard\'s layout, like a hardware keyboard</string>
    <string name="kdeconnect_pipeline_info">Off: what the computer sends is typed exactly. On: a Latin keyboard on the desk writes Bengali through Avro, and suggestions and autocorrect apply.</string>

    <!-- Touchpad -->
    <string name="kdeconnect_group_touchpad">Touchpad</string>
    <string name="kdeconnect_pad_speed_title">Pointer speed</string>
    <string name="kdeconnect_pad_accel_title">Acceleration</string>
    <string name="kdeconnect_pad_accel_subtitle">Slow moves are precise, fast moves go far</string>
    <string name="kdeconnect_scroll_speed_title">Scroll speed</string>
    <string name="kdeconnect_natural_scroll_title">Natural scrolling</string>
    <string name="kdeconnect_natural_scroll_subtitle">The page follows your fingers</string>
    <string name="kdeconnect_tap_click_title">Tap to click</string>
    <string name="kdeconnect_tap_click_subtitle">Two fingers for right click, three for middle</string>
    <string name="kdeconnect_pad_haptics_title">Vibrate on clicks</string>

    <!-- Sharing -->
    <string name="kdeconnect_group_sharing">Sharing</string>
    <string name="kdeconnect_receive_files_title">Receive files</string>
    <string name="kdeconnect_receive_files_subtitle">Saved to Downloads, in WM Keyboard, and added to the clipboard history</string>
    <string name="kdeconnect_share_sheet_title">Show in the share menu</string>
    <string name="kdeconnect_share_sheet_subtitle">Other apps can share to the computer. Only shown once a computer is paired</string>
    <string name="kdeconnect_battery_title">Report battery level</string>
    <string name="kdeconnect_battery_subtitle">The computer shows this phone\'s charge</string>
    <string name="kdeconnect_media_title">Offer this phone\'s media</string>
    <string name="kdeconnect_media_subtitle">The computer can pause and skip what plays here</string>
    <string name="kdeconnect_media_access_title">Notification access</string>
    <string name="kdeconnect_media_access_granted">Granted. Needed to see what is playing</string>
    <string name="kdeconnect_media_access_missing">Needed to see what is playing. Tap to grant</string>

    <!-- Help -->
    <string name="kdeconnect_help_title">If the computer does not show up</string>
    <string name="kdeconnect_help_body">1. Both devices are on the same network. Mobile data and most guest Wi-Fi do not work.\n2. KDE Connect is running on the computer.\n3. Its firewall allows ports 1714 to 1764, for TCP and UDP.\n4. Still nothing: add the computer by its IP address on the Devices screen.</string>

    <!-- Devices screen -->
    <string name="kdeconnect_devices_screen_subtitle">Paired computers, and the ones nearby</string>
    <string name="kdeconnect_devices_off">Turn KDE Connect on to look for computers</string>
    <string name="kdeconnect_devices_paired">Paired</string>
    <string name="kdeconnect_devices_nearby">Nearby</string>
    <string name="kdeconnect_devices_nearby_empty">Looking… Open KDE Connect on the computer</string>
