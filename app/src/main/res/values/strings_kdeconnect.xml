    <string name="kdeconnect_pairing_reject">Reject</string>
    <string name="kdeconnect_pairing_cancel">Cancel</string>
    <string name="kdeconnect_hosts_title">Added by address</string>
    <string name="kdeconnect_hosts_info">For networks that block discovery. This phone announces itself to each address directly, and the computer answers.</string>
    <string name="kdeconnect_hosts_label">IP address or host name</string>
    <string name="kdeconnect_hosts_add">Add</string>
