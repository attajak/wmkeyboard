    <string name="kdeconnect_device_files">Files and text</string>
    <string name="kdeconnect_device_battery">Battery report</string>
    <string name="kdeconnect_pairing_outgoing">Waiting for %1$s. Accept on the computer if it shows this code</string>
    <string name="kdeconnect_pairing_incoming">%1$s wants to pair. Accept only if it shows this code</string>
