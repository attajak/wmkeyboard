<?xml version="1.0" encoding="utf-8"?>
<!--
   In-app updates. Every channel that has an update source shows these: a Play
   build asks the Play Store, a direct-download build asks this project's
   GitHub releases and installs the new version itself, and an F-Droid build
   asks F-Droid and sends the user to F-Droid. Which one a string is about is a
   format argument, not a separate string, so there is one set of words to
   translate rather than three.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Where updates come from. Used as the argument in the strings below. -->
    <string name="update_source_play">the Play Store</string>
    <string name="update_source_github">GitHub</string>
    <string name="update_source_fdroid">F-Droid</string>

    <!-- The card on the home screen, when a new version is out. -->
    <string name="update_card_available_title">Update available</string>
    <!-- %1$s is the update source, from update_source_*. -->
    <string name="update_card_available_body">A newer version of WM Keyboard is on <xliff:g id="source" example="GitHub">%1$s</xliff:g>. You choose when to download it and when to install it.</string>
    <!-- The same card when the version is known. %1$s is the version, %2$s the source. -->
    <string name="update_card_available_body_versioned">WM Keyboard <xliff:g id="version" example="0.5.3">%1$s</xliff:g> is on <xliff:g id="source" example="GitHub">%2$s</xliff:g>. You choose when to download it and when to install it.</string>
    <!-- Shown instead of the body above when the release was published as high priority. %1$s = source. -->
    <string name="update_card_urgent_body">This update has an important fix. <xliff:g id="source" example="the Play Store">%1$s</xliff:g> installs it and restarts the app.</string>
    <string name="update_card_ready_title">Update ready to install</string>
    <string name="update_card_ready_body">The app closes and opens again to install the update. Your keyboard also restarts, so finish what you are typing first.</string>
    <!-- The same card for a build that installs the update itself. -->
    <string name="update_card_ready_body_self">The download is checked and ready. Installing closes the app and restarts your keyboard, so finish what you are typing first. Android asks you to confirm the first update.</string>
    <string name="update_card_downloading_title">Downloading the update</string>
    <string name="update_card_installing_title">Installing the update</string>
    <string name="update_card_installing_body">The app restarts in a moment.</string>
    <!-- The same card for a build that installs the update itself. -->
    <string name="update_card_installing_body_self">Android takes it from here. The app closes, and you can open it again when the update is done.</string>

    <!-- The card shown once, after the app has installed an update of itself. -->
    <!-- %1$s is the new version. -->
    <string name="update_card_updated_title">Updated to <xliff:g id="version" example="0.5.3">%1$s</xliff:g></string>
    <string name="update_card_updated_body">The update is installed and your keyboard is back.</string>

    <!-- Buttons on the card. -->
    <string name="update_action_download">Download</string>
    <string name="update_action_update">Update now</string>
    <string name="update_action_install">Install and restart</string>
    <string name="update_action_later">Not now</string>
    <string name="update_action_notes">What\'s new</string>
    <string name="update_action_dismiss">Got it</string>
    <!-- %1$s is the update source, from update_source_*. -->
    <string name="update_action_open_source">Open <xliff:g id="source" example="F-Droid">%1$s</xliff:g></string>

    <!-- Title of the dialog holding a release's notes. %1$s is the version. -->
    <string name="update_notes_title">What\'s new in <xliff:g id="version" example="0.5.9">%1$s</xliff:g></string>

    <!-- Release notes, when the release has none. -->
    <string name="update_notes_empty">This release has no notes</string>

    <!-- Download progress. %1$s = bytes so far, %2$s = total size, both with units. -->
    <string name="update_progress_body"><xliff:g id="downloaded" example="12 MB">%1$s</xliff:g> of <xliff:g id="total" example="30 MB">%2$s</xliff:g></string>

    <!-- First sentence of the dialog asked before a download starts on a metered
         connection. The datasaver_metered_* strings give the rest.
         %1$s is the download size, with units. -->
    <string name="update_metered_body">The update is <xliff:g id="size" example="45 MB">%1$s</xliff:g>.</string>

    <!-- About screen: the Updates group. -->
    <string name="update_section_title">Updates</string>
    <string name="update_row_check_title">Check for updates</string>
    <string name="update_row_check_subtitle">Ask if a newer version is out</string>
    <string name="update_row_checking_subtitle">Checking…</string>
    <string name="update_row_current_subtitle">This is the newest version</string>
    <string name="update_row_failed_subtitle">The check failed. Press to try again</string>
    <string name="update_row_failed_rate_limited_subtitle">GitHub will not answer more checks for now. Press to try again later</string>
    <string name="update_row_failed_no_asset_subtitle">This release has no file for your device. Press to try again</string>
    <string name="update_row_failed_no_space_subtitle">Not enough free space. Make some room, then press to try again</string>
    <string name="update_row_failed_corrupt_subtitle">The download did not match the release. Press to try again</string>
    <string name="update_row_failed_signature_subtitle">This release is signed with a different key than your install. Download it yourself from the release page</string>
    <string name="update_row_failed_blocked_subtitle">Your device does not let this app install updates</string>
    <string name="update_row_failed_install_subtitle">Android could not install the update. Press to try again</string>
    <string name="update_row_available_title">Download the update</string>
    <!-- %1$d = the version code of the new release, %2$s = its download size. -->
    <string name="update_row_available_subtitle">Version <xliff:g id="version_code" example="4">%1$d</xliff:g>, <xliff:g id="size" example="30 MB">%2$s</xliff:g></string>
    <!-- The same row, when there is no size to report. %1$d = version code. -->
    <string name="update_row_available_subtitle_plain">Version <xliff:g id="version_code" example="4">%1$d</xliff:g></string>
    <!-- The same row on a build that only points at its store. %1$s = version name, %2$s = source. -->
    <string name="update_row_available_title_external">Get the update</string>
    <string name="update_row_available_subtitle_external">Version <xliff:g id="version" example="0.5.3">%1$s</xliff:g> is on <xliff:g id="source" example="F-Droid">%2$s</xliff:g></string>
    <string name="update_row_downloading_title">Downloading the update</string>
    <string name="update_row_install_title">Install the update</string>
    <string name="update_row_install_subtitle">The app and the keyboard restart</string>
    <string name="update_row_installing_title">Installing the update</string>
    <string name="update_row_release_page_title">Release page</string>
    <string name="update_row_release_page_subtitle">Read the notes, or download the file yourself</string>

    <string name="update_row_prompts_title">Ask me about updates</string>
    <string name="update_row_prompts_subtitle">Offer a new version when you open this app</string>
    <string name="update_row_prereleases_title">Include pre-releases</string>
    <string name="update_row_prereleases_subtitle">Offer test versions before they are finished</string>

    <!-- The shade. An update the user started can outlive the settings screen
         they started it from, and a quiet install leaves nothing behind. -->
    <string name="update_notify_downloading_title">Downloading the update</string>
    <string name="update_notify_ready_title">Update ready to install</string>
    <string name="update_notify_ready_body">Tap to install it. The keyboard restarts.</string>
    <string name="update_notify_failed_title">The update did not finish</string>
    <!-- %1$s is the new version name, e.g. "0.5.7". -->
    <string name="update_notify_updated_title">
        Updated to <xliff:g id="version" example="0.5.7">%1$s</xliff:g>
    </string>
    <string name="update_notify_updated_body">Tap to see what changed</string>


    <!-- The dialog shown when a wmkeyboard:// settings link names a screen or a
         setting that this version of the app does not have. Usually the link
         is from a newer version, so the dialog checks for one. -->
    <string name="link_update_title">This version cannot open this link</string>
    <!-- %1$s is the version the link needs, from its since= part. -->
    <string name="link_update_title_versioned">This link needs version <xliff:g id="version" example="0.5.12">%1$s</xliff:g></string>
    <string name="link_update_title_unreleased">Not released yet</string>
    <string name="link_update_title_missing">Nothing to open</string>
    <!-- First sentence. %1$s is the installed version. -->
    <string name="link_update_lead_row">This link opens a setting that WM Keyboard <xliff:g id="version" example="0.5.11">%1$s</xliff:g> does not have.</string>
    <string name="link_update_lead_screen">This link opens a screen that WM Keyboard <xliff:g id="version" example="0.5.11">%1$s</xliff:g> does not have.</string>
    <!-- Second sentence, one of the strings below. -->
    <!-- %1$s is the version the link says has the setting. It is not newer than the installed one. -->
    <string name="link_update_missing_body">The link says that version <xliff:g id="version" example="0.5.9">%1$s</xliff:g> has it, so an update does not help. The link can have a mistake in it, or the setting moved or was removed.</string>
    <string name="link_update_ask">Check for a newer version?</string>
    <string name="link_update_checking">Looking for a newer version…</string>
    <!-- %1$s is the update source, from update_source_*. -->
    <string name="link_update_available">A newer version is on <xliff:g id="source" example="the Play Store">%1$s</xliff:g>. Update, then open the link again.</string>
    <!-- %1$s is the new version, %2$s the update source. -->
    <string name="link_update_available_versioned">Version <xliff:g id="version" example="0.5.12">%1$s</xliff:g> is on <xliff:g id="source" example="GitHub">%2$s</xliff:g>. Update, then open the link again.</string>
    <string name="link_update_not_released">You have the newest release. The link can be for a version that is not released yet, or it can have a mistake in it. To get a new version before its release, build the app from its source code on GitHub.</string>
    <!-- %1$s is the version the link needs. -->
    <string name="link_update_not_released_versioned">No release has version <xliff:g id="version" example="0.5.12">%1$s</xliff:g> yet. Wait for the official release, or build the app from its source code on GitHub.</string>
    <string name="link_update_updating">An update is on its way. Open the link again after it is installed.</string>
    <string name="link_update_check_failed">The check for a newer version failed.</string>
    <string name="link_update_no_updater">This copy of the app cannot check for updates. Look for a newer version where you got the app, or in the releases on GitHub.</string>
    <!-- %1$s is the version the link needs. -->
    <string name="link_update_no_updater_versioned">This copy of the app cannot check for updates. Get version <xliff:g id="version" example="0.5.12">%1$s</xliff:g> or newer where you got the app, or from the releases on GitHub.</string>
    <string name="link_update_action_source">Source code</string>
    <string name="link_update_action_releases">Releases</string>
</resources>
