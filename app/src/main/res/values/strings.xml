<resources>
    <string name="app_name">WM Keyboard</string>
    <!-- The launcher label when About › Short app name is on (#140). A name,
         not a word, so no language translates it. -->
    <string name="app_name_short" translatable="false">WMK</string>
    <!-- Digital Asset Links statement read by Chrome for
         navigator.getInstalledRelatedApps() on the docs site. The site is
         DOCS_URL in AboutScreens.kt; change both together.

         It must target the WEB namespace: the question Chrome answers is
         whether this app vouches for that site, so the statement this app
         publishes has to name the site. An "include" of the site's own
         /.well-known/assetlinks.json does not work, however right it looks:
         that file's statements target an android_app, so following it leaves
         this app vouching for itself and Chrome reports the app as missing.
         The site file stays where it is; it answers the other direction. -->
    <string name="asset_statements" translatable="false">[{\"relation\": [\"delegate_permission/common.handle_all_urls\"], \"target\": {\"namespace\": \"web\", \"site\": \"https://wmkeyboard.pages.dev\"}}]</string>
    <string name="ime_name">WM Keyboard</string>
    <!-- Play's name for the on-demand AI-runtime module (:feature:llm);
         surfaces in Play's download UI and settings. Lives here because a
         dist:title must resolve from the BASE module's resources. -->
    <string name="llm_module_title">On-device AI</string>
    <!-- The same for the on-demand translator module (:feature:translate). -->
    <string name="translate_module_title">On-device translation</string>
    <!-- The same for :feature:litert, which offline voice typing and the
         sticker editor's background remover share, and :feature:handwriting. -->
    <string name="litert_module_title">Offline voice typing and sticker cutout</string>
    <string name="handwriting_module_title">Handwriting recognition</string>
    <!-- Shown in Settings › Notification access for the listener that the
         media-control tool and the one-time code chip share. It is the whole
         sentence the user reads before granting, so it names both features:
         the media tool reads only the session, the code chip reads
         notification text while it is on. -->
    <string name="media_listener_label">WM Keyboard media controls and one-time codes</string>
    <!-- Shown in Settings › Accessibility for the keyboard-gesture
         pass-through service. -->
    <string name="passthrough_service_label">WM Keyboard gestures</string>
    <string name="passthrough_service_summary">Keeps WM Keyboard\'s gestures working with a screen reader</string>
    <string name="passthrough_service_description">This service keeps the keyboard gestures available while a screen reader runs. The gestures are the spacebar cursor slide, the backspace word swipe, glide typing and handwriting.\n\nThe service reads nothing. It receives no accessibility events. It cannot see the screen content. Its only action is to mark the keyboard window to pass touches straight through. Every touch outside the keyboard still goes to your screen reader as usual.</string>
    <!--
      Shown in the "open with" chooser for the keyboard's own files
      (.wmtheme.json, .wmlayout.json, .wmconfig.json, .wmstickers, …), so it
      has to read as an action rather than as the app's name.
    -->
    <string name="import_file_label">Import into WM Keyboard</string>
    <!--
      Launcher shortcuts (long-press the app icon). "short" is what the launcher
      draws under the icon and is clipped hard — around 10 characters — so it is
      a bare noun; "long" is the accessibility label and the text used when
      there is room, so it names the app's own screen.
    -->
    <string name="shortcut_ai_chat_short">AI chat</string>
    <string name="shortcut_ai_chat_long">Chat with the AI</string>
    <string name="shortcut_themes_short">Themes</string>
    <string name="shortcut_themes_long">Keyboard themes</string>
    <string name="shortcut_languages_short">Languages</string>
    <string name="shortcut_languages_long">Languages &amp; layouts</string>
    <string name="shortcut_tools_short">Tools</string>
    <string name="shortcut_tools_long">Keyboard tools</string>
</resources>
