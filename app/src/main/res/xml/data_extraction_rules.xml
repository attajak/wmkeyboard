<?xml version="1.0" encoding="utf-8"?>
<!--
   What Android's backup may copy, on API 31+. Whether it copies anything at
   all is a separate, user-facing question: WMBackupAgent declines the whole
   backup unless "Back up with Android" is on under Settings → Privacy, and it
   is off by default. These rules only decide the shape of a backup the user
   has already asked for.

   Everything is included by default, so the entries below are the exceptions.
   They are all size, not secrecy: Auto Backup's per-app quota is a few tens of
   megabytes, and a backup that goes over it is dropped whole. So anything the
   app can fetch again on its own — speech and language models, downloaded
   dictionaries, emoji keyword packs — stays out, along with the scratch
   directories the camera and document scanner write into. What is left is the
   part that cannot be recovered from anywhere: settings, themes, layouts,
   snippets, learned words, sticker and icon packs, plugins, fonts, and the
   word lists the user imported themselves (files/dictionaries, which is not
   the same thing as the downloaded files/dict).

   cloud-backup additionally requires client-side encryption: with
   disableIfNoEncryptionCapabilities set, a device that cannot encrypt the
   backup under the user's own screen lock does not make one.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- On-device speech and LLM weights: hundreds of MB, re-downloadable. -->
        <exclude domain="file" path="models" />
        <exclude domain="file" path="whisper" />
        <!-- The sticker editor's background remover: small, but the same kind of thing. -->
        <exclude domain="file" path="cutout" />
        <!-- Compiled and downloaded word lists, likewise. -->
        <exclude domain="file" path="dict" />
        <exclude domain="file" path="cjk_dicts" />
        <exclude domain="file" path="emoji_dict" />
        <exclude domain="file" path="emoji_keywords" />
        <!-- Scratch space for the camera and document scanner. -->
        <exclude domain="file" path="camera" />
        <exclude domain="file" path="docscan" />
        <!-- Copied images backing clipboard entries; the text history stays. -->
        <exclude domain="file" path="clipboard/images" />
        <!--
           The photos stickers were cut out of. The stickers themselves are
           backed up; these are the uncropped originals behind them, they are
           the largest thing in files/stickers, and they only buy a future
           edit. A sticker pack the user exports never carries them either.
        -->
        <exclude domain="file" path="stickers/.originals" />
        <!--
           The KDE Connect identity: this device's private key and certificate,
           and the certificates of paired computers. Restored onto another
           phone they would put two devices on the network under one identity,
           and hand the second one every pairing the first ever made.
        -->
        <exclude domain="file" path="kdeconnect" />
        <!--
           The network activity log. A record of this device's requests, not a
           setting: restored onto another phone it would describe traffic that
           phone never made.
        -->
        <exclude domain="file" path="netlog" />
    </cloud-backup>

    <device-transfer>
        <exclude domain="file" path="models" />
        <exclude domain="file" path="whisper" />
        <exclude domain="file" path="cutout" />
        <exclude domain="file" path="dict" />
        <exclude domain="file" path="cjk_dicts" />
        <exclude domain="file" path="emoji_dict" />
        <exclude domain="file" path="emoji_keywords" />
        <exclude domain="file" path="camera" />
        <exclude domain="file" path="docscan" />
        <exclude domain="file" path="clipboard/images" />
        <exclude domain="file" path="stickers/.originals" />
        <exclude domain="file" path="kdeconnect" />
        <!--
           The network activity log. A record of this device's requests, not a
           setting: restored onto another phone it would describe traffic that
           phone never made.
        -->
        <exclude domain="file" path="netlog" />
    </device-transfer>
</data-extraction-rules>
