<?xml version="1.0" encoding="utf-8"?>
<!--
     The television launcher's banner: 320x180, the shape every TV home screen
     draws its app tiles in. Required for a LEANBACK_LAUNCHER entry — without
     one the launcher shows an empty tile.

     Built out of the two layers the adaptive icon already has rather than a
     bitmap of its own: the brand gradient stretched to the banner's aspect, and
     the monochrome keyboard-and-pin mark (white, so it reads on that gradient)
     centred on top at its own size. One file, no per-density artwork, and a
     change to the icon carries here by itself.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item
        android:width="108dp"
        android:height="108dp"
        android:drawable="@drawable/ic_launcher_monochrome"
        android:gravity="center" />
</layer-list>
